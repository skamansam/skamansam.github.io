# GitHub API Configuration
# To enable GitHub Discussions comments on blog posts, you need to create a GitHub Personal Access Token
# with the following permissions:
# - repo (Full control of private repositories) OR public_repo (Access public repositories)
# - read:discussion (Read discussions)
# - write:discussion (Write discussions)
#
# Create a token at: https://github.com/settings/tokens/new
# Then copy this file to .env and add your token below

VITE_GITHUB_TOKEN=your_github_token_here
