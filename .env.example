# GitHub API Configuration
# To enable GitHub Discussions comments on blog posts, you need to create GitHub Personal Access Tokens

# READ-ONLY TOKEN (for displaying comments on the website)
# This token is exposed to the client, so it should have minimal permissions:
# - public_repo (Access public repositories) - OPTIONAL, only if you want to show private repo discussions
# - read:discussion (Read discussions)
#
# Create a token at: https://github.com/settings/tokens/new
VITE_GITHUB_TOKEN_READONLY=your_readonly_token_here

# WRITE TOKEN (for sync script and posting comments - server-side only)
# This token needs write permissions and should NOT be exposed to the client:
# - public_repo (Access public repositories) OR repo (Full control)
# - read:discussion (Read discussions)
# - write:discussion (Write discussions)
#
# This is used by the sync script and GitHub Actions
GITHUB_TOKEN=your_write_token_here

# Legacy: VITE_GITHUB_TOKEN (deprecated, use VITE_GITHUB_TOKEN_READONLY instead)
# If set, this will be used as a fallback for both read and write operations
VITE_GITHUB_TOKEN=
